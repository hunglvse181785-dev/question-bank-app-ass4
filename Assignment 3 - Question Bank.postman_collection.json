{
  "info": {
    "name": "Assignment 3 - Question Bank",
    "description": "Assignment 3 requests use full URLs (no collection variables). Replace PASTE_* placeholders with tokens or IDs from earlier responses. Register ordinary users, promote the designated admin account in MongoDB (admin=true), then log in as Admin. Run denial checks before final delete requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication",
      "description": "Create normal users and store bearer tokens. Admin login requires a user already promoted to admin=true in MongoDB.",
