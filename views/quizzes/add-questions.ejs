<style>
  .question-entry {
    margin-bottom: 20px;
    padding: 22px;
    border: 1px solid #dbe3ef;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 3px 12px rgb(15 23 42 / 4%);
  }

  .question-entry-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }

  .question-entry-header h2 {
    margin: 0;
    font-size: 20px;
  }

  .question-entry > div {
    margin-bottom: 16px;
  }

  .question-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .question-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 20px 0;
  }

  .quiz-form .add-question-button {
    border-color: #bfdbfe;
    background: #eff6ff;
    color: #1d4ed8;
  }

  .quiz-form .add-question-button:hover {
    border-color: #93c5fd;
    background: #dbeafe;
  }

  .quiz-form .remove-question-button {
    min-height: 34px;
    padding: 6px 12px;
    border-color: #fecaca;
    background: #fef2f2;
    color: #b91c1c;
    font-size: 14px;
  }

  .quiz-form .remove-question-button:hover {
    border-color: #fca5a5;
    background: #fee2e2;
  }

  .quiz-form button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .question-help {
    color: #64748b;
    font-size: 14px;
  }

  .question-error {
    padding: 12px 16px;
    border: 1px solid #fecaca;
    border-radius: 9px;
    background: #fef2f2;
    color: #b91c1c;
  }

  @media (max-width: 576px) {
    .question-options {
      grid-template-columns: 1fr;
    }

    .question-entry {
      padding: 16px;
    }
  }
</style>

<h1>Thêm câu hỏi vào quiz</h1>

<p><strong>Quiz:</strong> <%= quiz.title %></p>

<p>
  <a href="/quizzes/<%= quiz._id %>">← Chi tiết quiz</a>
</p>

<p class="question-help">
  Nhập câu hỏi bên dưới. Muốn thêm nhiều câu, bấm
  “+ Thêm câu hỏi khác”, rồi lưu tất cả một lần.
</p>

<% if (error) { %>
  <p class="question-error" role="alert"><%= error %></p>
<% } %>

<form
  id="questions-form"
  class="quiz-form"
  action="/quizzes/<%= quiz._id %>/add-questions"
  method="POST"
>
  <div id="questions-container">
    <% questions.forEach(function (question, index) { %>
      <article class="question-entry">
        <header class="question-entry-header">
          <h2 class="question-number">Câu hỏi <%= index + 1 %></h2>

          <button
            type="button"
            class="remove-question-button"
          >
            Bỏ câu hỏi này
          </button>
        </header>

        <div>
          <label for="question-<%= index %>-text">
            Nội dung câu hỏi *
          </label>
          <textarea
            id="question-<%= index %>-text"
            name="text"
            rows="3"
            placeholder="Ví dụ: Thủ đô của Việt Nam là gì?"
            required
          ><%= question.text %></textarea>
        </div>

        <div class="question-options">
          <% ['A', 'B', 'C', 'D'].forEach(function (letter, optionIndex) { %>
            <div>
              <label for="question-<%= index %>-option-<%= letter %>">
                Lựa chọn <%= letter %> *
              </label>
              <input
                id="question-<%= index %>-option-<%= letter %>"
                name="option<%= letter %>"
                type="text"
                value="<%= question.options[optionIndex] || '' %>"
                required
              >
            </div>
          <% }); %>
        </div>

        <div>
          <label for="question-<%= index %>-answer">
            Đáp án đúng *
          </label>
          <select
            id="question-<%= index %>-answer"
            name="correctAnswerIndex"
            required
          >
            <option
              value=""
              <%= question.correctAnswerIndex < 0 ? 'selected' : '' %>
            >
              Chọn đáp án đúng
            </option>

            <% ['A', 'B', 'C', 'D'].forEach(function (letter, optionIndex) { %>
              <option
                value="<%= optionIndex %>"
                <%= question.correctAnswerIndex === optionIndex ? 'selected' : '' %>
              >
                Lựa chọn <%= letter %>
              </option>
            <% }); %>
          </select>
        </div>

        <div>
          <label for="question-<%= index %>-keywords">
            Từ khóa
          </label>
          <input
            id="question-<%= index %>-keywords"
            name="keywords"
            type="text"
            value="<%= question.keywords %>"
            placeholder="Ví dụ: địa lý, thủ đô, Việt Nam"
          >
          <small class="question-help">
            Có thể bỏ trống. Ngăn cách các từ khóa bằng dấu phẩy.
          </small>
        </div>
      </article>
    <% }); %>
  </div>

  <div class="question-toolbar">
    <button
      id="add-question-button"
      class="add-question-button"
      type="button"
    >
      + Thêm câu hỏi khác
    </button>

    <button id="save-questions-button" type="submit">
      Lưu tất cả câu hỏi
    </button>
  </div>

  <p id="question-count" class="question-help" aria-live="polite"></p>
</form>

<script>
  (function () {
    const form = document.getElementById('questions-form');
    const container = document.getElementById('questions-container');
    const addButton = document.getElementById('add-question-button');
    const saveButton = document.getElementById('save-questions-button');
    const countLabel = document.getElementById('question-count');

    // Lấy cấu trúc khung nhập để tạo câu hỏi mới.
    const template = container
      .querySelector('.question-entry')
      .cloneNode(true);

    function updateQuestions() {
      const entries = container.querySelectorAll('.question-entry');

      entries.forEach(function (entry, index) {
        entry.querySelector('.question-number').textContent =
          'Câu hỏi ' + (index + 1);

        entry.querySelector('.remove-question-button').disabled =
          entries.length === 1;

        // Cập nhật ID và label để không trùng giữa các câu hỏi.
        entry.querySelectorAll('textarea, input, select').forEach(
          function (field) {
            const oldId = field.id;
            const newId = 'question-' + index + '-' + field.name;

            entry.querySelectorAll('label').forEach(function (label) {
              if (label.htmlFor === oldId) {
                label.htmlFor = newId;
              }
            });

            field.id = newId;
          }
        );
      });

      countLabel.textContent =
        'Bạn đang soạn ' + entries.length + ' câu hỏi.';
    }

    addButton.addEventListener('click', function () {
      const entry = template.cloneNode(true);

      entry.querySelectorAll('input, textarea').forEach(function (field) {
        field.value = '';
      });

      entry.querySelector('select').value = '';

      container.appendChild(entry);
      updateQuestions();

      entry.querySelector('textarea').focus();
    });

    container.addEventListener('click', function (event) {
      const removeButton = event.target.closest(
        '.remove-question-button'
      );

      if (!removeButton) return;

      const entries = container.querySelectorAll('.question-entry');
      if (entries.length <= 1) return;

      removeButton.closest('.question-entry').remove();
      updateQuestions();
    });

    form.addEventListener('submit', function () {
      saveButton.disabled = true;
      saveButton.textContent = 'Đang lưu...';
    });

    window.addEventListener('pageshow', function () {
      saveButton.disabled = false;
      saveButton.textContent = 'Lưu tất cả câu hỏi';
    });

    updateQuestions();
  })();
</script>