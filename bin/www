#!/usr/bin/env node

const app = require('../app');
const https = require('https');
const http = require('http');
const fs = require('fs');
const path = require('path');
const connectDB = require('../config/db');

const port = Number(process.env.PORT || 3443);
const isProduction = process.env.NODE_ENV === 'production';

if (!Number.isInteger(port) || port < 1 || port > 65535) {
  console.error('PORT phải là số nguyên từ 1 đến 65535');
  process.exit(1);
}

app.set('port', port);

async function start() {
  try {
    await connectDB();

    // Render cung cấp HTTPS ở proxy và yêu cầu ứng dụng nghe HTTP trên PORT.
    // HTTPS với chứng chỉ tự ký chỉ dùng cho môi trường local.
    const server = isProduction
      ? http.createServer(app)
      : https.createServer({
          key: fs.readFileSync(path.join(__dirname, '../certs/localhost-key.pem')),
          cert: fs.readFileSync(path.join(__dirname, '../certs/localhost-cert.pem'))
        }, app);

    server.on('error', function (error) {
      console.error('Không thể chạy server:', error.message);
      process.exit(1);
    });

    server.listen(port, '0.0.0.0', function () {
      console.log(isProduction
        ? `Server HTTP đang chạy trên cổng ${port}`
        : `Server HTTPS đang chạy tại https://localhost:${port}`);
    });
  } catch (error) {
    console.error('Khởi động thất bại:', error.message);
    process.exit(1);
  }
}

start();
